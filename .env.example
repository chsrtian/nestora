# Public client-side values (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Cloudflare Turnstile site key for the registration form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only; never expose to frontend code.
TURNSTILE_SECRET_KEY=

# Server-side only; never expose to frontend code.
# Used by npm run seed:ph to apply migration 0007 and the Cabadbaran seed.
SUPABASE_DB_URL=

# Server-side only; never expose to frontend code.
OPENROUTER_API_KEY=
